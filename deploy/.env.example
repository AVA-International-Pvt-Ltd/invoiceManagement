# Default image on Docker Hub — account team can use install.ps1 / install.sh as-is.
IMAGE=yashjeetamai/invoice-finintel:latest
PORT=8080

# Supabase (optional until the image is built with these values).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are server-only.
# VITE_* values are baked into the frontend at image build time.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ALLOWED_EMAIL_DOMAIN=avaipl.com
VITE_ALLOWED_EMAIL_DOMAIN=avaipl.com
