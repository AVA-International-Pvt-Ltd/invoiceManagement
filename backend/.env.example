# Copy to backend/.env (or the repo root .env). Never commit the real file.
# Project URL and service_role key: Supabase → Project Settings → API.
# The service role key stays on the server. Do not put it in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAIL_DOMAIN=avaipl.com
