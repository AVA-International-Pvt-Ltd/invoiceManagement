# Copy to frontend/.env.local
# Use the anon public key only. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_ALLOWED_EMAIL_DOMAIN=avaipl.com
# Leave empty in local dev (Vite proxies /api). Set to the Cloud Run URL in production.
VITE_API_BASE=
